<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/robot"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_purple"
            android:padding="4dp"
            android:layout_marginEnd="16dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hey, Student! 👋"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your space to think and dream"
                android:textColor="#888888"
                android:textSize="13sp"/>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/tabThought"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="🌀 Thought Parking"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:gravity="center"
            android:background="@drawable/chip_purple"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tabFuture"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="🕐 Future You"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:gravity="center"
            android:background="@drawable/chip_dark"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etThought"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Park a thought here..."
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/edittext_dark"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnPark"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="➤"
            android:textSize="16sp"
            android:padding="0dp"
            android:backgroundTint="#7C4DFF"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvThoughts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="#1A1A1A"
        android:gravity="center">

        <TextView
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="💬&#10;Chat"
            android:textColor="#555555"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/navPlanner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📅&#10;Planner"
            android:textColor="#555555"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/navBag"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🎒&#10;Bag"
            android:textColor="#555555"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/navMemories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="✨&#10;Memories"
            android:textColor="#555555"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="👤&#10;Profile"
            android:textColor="#B388FF"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="8dp"/>

    </LinearLayout>

</LinearLayout>