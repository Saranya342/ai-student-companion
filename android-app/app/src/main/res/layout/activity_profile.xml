<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- ✅ Round profile avatar -->
        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/circle_purple"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/robot"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hey!"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="email@example.com"
                android:textColor="#888888"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Daily High-Five card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/card_dark"
        android:padding="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily High‑Five 🙌"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHighFiveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to mark today's high‑five"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnHighFive"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Mark High‑Five"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#7C4DFF" />

    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MORE"
            android:textColor="#555555"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/itemSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⚙ Settings"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:background="@drawable/card_dark"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/itemHelp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="❓ Help / FAQ"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:background="@drawable/card_dark"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/itemAbout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ℹ About"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:background="@drawable/card_dark"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Logout"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#FF5252" />

    </LinearLayout>

    <include layout="@layout/view_bottom_nav" />

</LinearLayout>