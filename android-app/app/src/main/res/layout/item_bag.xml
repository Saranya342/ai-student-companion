<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_dark"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="10dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">

    <TextView
        android:id="@+id/tvItemEmoji"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text=""
        android:textSize="20sp"
        android:textColor="@color/mm_on_accent"
        android:gravity="center"
        android:background="@drawable/circle_purple"
        android:layout_marginEnd="12dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBagItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvItemCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/mm_text_secondary"
            android:textSize="11sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/btnDeleteItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="X"
        android:textSize="14sp"
        android:textColor="@color/mm_error"
        android:padding="10dp"
        android:layout_marginEnd="6dp"/>

    <CheckBox
        android:id="@+id/checkBagItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/mm_accent"/>
</LinearLayout>