<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#1A1A1A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What are you proud of? ✨"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etMemoryContent"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:hint="Share your proud moment..."
        android:textColorHint="#555555"
        android:textColor="#FFFFFF"
        android:gravity="top"
        android:padding="12dp"
        android:background="@drawable/edittext_dark"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category:"
        android:textColor="#888888"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"/>

    <!-- Category chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/catWin"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="🏆 Win"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chip_purple"/>

        <TextView
            android:id="@+id/catStudy"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="📚 Study"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chip_dark"/>

        <TextView
            android:id="@+id/catGrowth"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="💪 Growth"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chip_dark"/>

        <TextView
            android:id="@+id/catNote"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="📝 Note"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:background="@drawable/chip_dark"/>

    </LinearLayout>

</LinearLayout>