<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Journal"
        android:textColor="?attr/colorOnSurface"
        android:textSize="28sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:background="?attr/colorSurface"/>

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/tabThought"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Thought Parking"
            android:textColor="@color/mm_on_accent"
            android:textSize="13sp"
            android:gravity="center"
            android:background="@drawable/chip_purple"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tabFuture"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Future You"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            android:gravity="center"
            android:background="@drawable/chip_dark"/>
    </LinearLayout>

    <!-- THOUGHT PARKING -->
    <LinearLayout
        android:id="@+id/thoughtLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:background="@drawable/card_dark">

            <EditText
                android:id="@+id/etThought"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Type your thought..."
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="@color/mm_text_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/edittext_dark"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/btnSendThought"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text=">"
                android:textColor="@color/mm_on_accent"
                android:textSize="16sp"
                android:gravity="center"
                android:background="@drawable/circle_purple"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/thoughtContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"/>
        </ScrollView>
    </LinearLayout>

    <!-- FUTURE YOU -->
    <LinearLayout
        android:id="@+id/futureLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="16dp">

        <EditText
            android:id="@+id/etFuture"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:hint="Dear future me..."
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="@color/mm_text_secondary"
            android:padding="14dp"
            android:gravity="top"
            android:background="@drawable/card_dark"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnSendFuture"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Send to Future Me"
            android:textColor="@color/mm_on_accent"
            android:backgroundTint="@color/mm_accent"
            android:layout_marginBottom="14dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/futureContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>
    </LinearLayout>

    <!-- Material Bottom Navigation -->
    <include layout="@layout/view_bottom_nav" />

</LinearLayout>